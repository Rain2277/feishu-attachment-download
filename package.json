{
  "name": "feishu-attachment-download",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "飞书多维表格边栏插件：附件批量下载，支持自定义命名规则并打包 ZIP",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test:naming": "esbuild test-naming.mts --bundle --platform=node --format=esm --outfile=test-naming.mjs && node test-naming.mjs"
  },
  "dependencies": {
    "@lark-base-open/js-sdk": "^1.0.2",
    "jszip": "^3.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
